// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model ActivityRecord {
  id        Int      @id @default(autoincrement())
  source    String
  eventType String
  payload   String
  createdAt DateTime @default(now())
}

/// Cumulative set of app names ever observed from ActivityWatch (union over syncs).
model KnownApp {
  appName     String   @id
  firstSeenAt DateTime
  lastSeenAt  DateTime
  lastTitle   String?
}

/// User-selected apps to ignore (e.g. for future feed filtering).
model IgnoredApp {
  appName String @id
}
